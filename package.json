{
  "name": "@agentage/platform-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Everything an agentage extension author imports or runs: the extension kit, its build tool and the widget kit",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "build": "npm run css && tsc -b",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo coverage packages/widget/src/ds/styles.generated.ts packages/widget/src/test-support/fixture/dist",
    "css": "npm run css -w @agentage/widget",
    "type-check": "npm run css && tsc -b && tsc -p packages/extension/tsconfig.eslint.json --noEmit && tsc -p packages/widget/tsconfig.eslint.json --noEmit && tsc -p packages/identity/tsconfig.eslint.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run css",
    "test": "vitest run",
    "pretest:coverage": "npm run css",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run test:e2e -w @agentage/widget",
    "schemas": "npm run schemas -w @agentage/extension",
    "check:fixtures": "npm run check:fixtures -w @agentage/extension",
    "verify": "npm run type-check && npm run lint && npm run format:check && npm run test:coverage && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-hooks": "7.1.1",
    "express": "5.3.0",
    "jsdom": "30.1.3",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "license": "MIT",
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
