{
  "name": "@agentage/identity",
  "version": "0.2.0",
  "description": "The agentage identity client for browser pages: sign in at auth, a one-day token for the parts, sign out",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentage/platform.git",
    "directory": "packages/identity"
  },
  "homepage": "https://agentage.io",
  "bugs": {
    "url": "https://github.com/agentage/platform/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b",
    "verify": "npm run verify --prefix ../..",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "zod": "^4.2.0"
  },
  "keywords": [
    "agentage",
    "extension",
    "identity"
  ]
}
