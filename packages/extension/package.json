{
  "name": "@agentage/extension",
  "version": "0.12.1",
  "description": "The agentage extension kit: create(ctx) per part (pages, ui, api, mcp, worker, cli), the store, /health, discovery, the envelope, and the build tool with up and token",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentage/platform.git",
    "directory": "packages/extension"
  },
  "homepage": "https://agentage.io",
  "bugs": {
    "url": "https://github.com/agentage/platform/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tool": {
      "types": "./dist/tool/index.d.ts",
      "default": "./dist/tool/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./logs": {
      "types": "./dist/logs/index.d.ts",
      "default": "./dist/logs/index.js"
    },
    "./migrate": {
      "default": "./dist/store/migrate.js"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas",
    "!dist/**/*.test.*",
    "!dist/test-support"
  ],
  "scripts": {
    "build": "tsc -b && node ../../scripts/inline-logs.mjs",
    "schemas": "node dist/schemas/write-schemas.js schemas",
    "verify": "npm run verify --prefix ../..",
    "prepublishOnly": "npm run verify",
    "check:fixtures": "vitest run --root ../.. --reporter=tree packages/extension/src/tool/check.fixtures.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "semver": "^7.8.6",
    "zod": "^4.2.0"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "^0.5.0",
    "express": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "keywords": [
    "agentage",
    "extension"
  ],
  "devDependencies": {
    "@agentage/logs": "^0.1.0"
  }
}
